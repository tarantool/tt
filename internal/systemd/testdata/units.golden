==> myapp@.service <==
# Generated by tt service systemd: the instances of the application myapp.
# tt service systemd install writes this file anew: put settings of your own,
# such as User=, into a drop-in, myapp@.service.d/override.conf. Restart= and
# TimeoutStopSec= of an instance come from instances.yaml, through its drop-in
# myapp@<instance>.service.d/tt.conf.
[Unit]
Description=Tarantool application myapp, instance %i
After=network.target

[Service]
Type=simple
User=tarantool
Group=tarantool
Environment=TT_SYSTEM_ROOT=/app/tarantool
Environment=TT_SYSTEMD_UNIT=%n
ExecStart=/app/tarantool/bin/tt instance start --foreground --scope system myapp:%i
# tt stops the instance itself: SIGTERM goes to tt alone, which sends the
# instance its stop signal and kills it once its stop_timeout is up.
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes
# For an instance without a drop-in: the defaults of instances.yaml.
Restart=no
RestartSec=5s
TimeoutStopSec=35s
LimitNOFILE=65535
LimitCORE=infinity

[Install]
WantedBy=multi-user.target

==> myapp@router-1.service.d/tt.conf <==
# Generated by tt service systemd: the instance router-1 of myapp,
# from restart and stop_timeout of its record in instances.yaml.
# tt service systemd install writes this file anew.
[Service]
Restart=no
TimeoutStopSec=35s

==> myapp@storage-1.service.d/tt.conf <==
# Generated by tt service systemd: the instance storage-1 of myapp,
# from restart and stop_timeout of its record in instances.yaml.
# tt service systemd install writes this file anew.
[Service]
Restart=on-failure
TimeoutStopSec=125s

==> myapp@worker.a.service.d/tt.conf <==
# Generated by tt service systemd: the instance worker.a of myapp,
# from restart and stop_timeout of its record in instances.yaml.
# tt service systemd install writes this file anew.
[Service]
Restart=always
TimeoutStopSec=7s
