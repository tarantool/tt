  -h, --help        help for install
      --no-clean    Keep temporary files
      --reinstall   Reinstall an existing version
[0;1;39m
GLOBAL FLAGS[0m
      --scope string   Scope: project, user or system (default "project")
  -V, --verbose        Show diagnostic output and build commands
[0;1;39m
EXAMPLES[0m
  # Install the latest Tarantool release for this project.
  $ tt binary install tarantool

  # Install tt for the current user.
  $ tt binary install tt --scope user

  # Install a local Enterprise archive system-wide.
