==> .templates/default/config.yaml <==
credentials:
  users:
    replicator:
      password: 'topsecret'
      roles: [replication]
    client:
      password: 'secret'
      privileges:
        - permissions: [execute]
          lua_call:
            - config.storage.get
            - config.storage.put
            - config.storage.delete
            - config.storage.keepalive
            - config.storage.txn
            - config.storage.info
        # Not necessary since tarantool 3.5.0, 3.4.1, 3.3.3, 3.2.2.
        - permissions: [read, write]
          spaces: [config_storage, config_storage_meta]

iproto:
  advertise:
    peer:
      login: replicator

replication:
  failover: election

database:
  use_mvcc_engine: true

groups:
  group-001:
    replicasets:
      replicaset-001:
        roles: [config.storage]
        roles_cfg:
          config.storage:
            status_check_interval: 5
        instances:
          replicaset-001-a:
            iproto:
              listen:
              - uri: 127.0.0.1:3301
          replicaset-001-b:
            iproto:
              listen:
              - uri: 127.0.0.1:3302
          replicaset-001-c:
            iproto:
              listen:
              - uri: 127.0.0.1:3303
==> .templates/default/instances.yaml <==
# The instances the template runs: "*" stands for every instance of the
# topology of config.yaml, started in the order of their names.
#
# Settings for all of them go into "*", such as starting an instance again
# after it fails:
#
#   "*":
#     restart: on-failure
#
# An instance given a record of its own takes the settings of that record,
# and none of "*". An external process is declared by its name, with its
# binary relative to the project directory:
#
#   worker:
#     binary: ./bin/worker
#     args: [--port, "8080"]
"*": {}
